{
  "name": "kanjimo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kanjimo – Kanji lernen mit Mo, dem Tintentropfen",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "fetch:strokes": "node scripts/fetch-kanjivg.mjs",
    "icons": "node scripts/make-icons.mjs",
    "fonts": "node scripts/subset-fonts.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "@fontsource/klee-one": "^5.3.1",
    "@fontsource/m-plus-rounded-1c": "^5.3.0"
  }
}
